#!/bin/sh
# miniupnpd integration for firewall3

IPTABLES=/usr/sbin/iptables
IP6TABLES=/usr/sbin/ip6tables

$IPTABLES -t filter -N MINIUPNPD 2>/dev/null
$IPTABLES -t nat -N MINIUPNPD 2>/dev/null
$IPTABLES -t nat -N MINIUPNPD-POSTROUTING 2>/dev/null

[ -x $IP6TABLES ] && $IP6TABLES -t filter -N MINIUPNPD 2>/dev/null

. /lib/functions/network.sh

iptables_prepend_rule() {
	local iptables="$1"
	local table="$2"
	local chain="$3"
	local target="$4"

	$iptables -t "$table" -nL "$chain" >/dev/null 2>&1 || return
	$iptables -t "$table" -D "$chain" -j "$target" 2>/dev/null
	$iptables -t "$table" -I "$chain" 1 -j "$target"
}

ADDED=0

add_extzone_rules() {
	local ext_zone="$1"

	[ -z "$ext_zone" ] && return

	$IPTABLES -t filter -D "zone_${ext_zone}_input" -j MINIUPNPD 2>/dev/null
	$IPTABLES -t filter -D "zone_${ext_zone}_forward" -j MINIUPNPD 2>/dev/null
	$IPTABLES -t nat -D "zone_${ext_zone}_prerouting" -j MINIUPNPD 2>/dev/null
	$IPTABLES -t nat -D "zone_${ext_zone}_postrouting" -j MINIUPNPD-POSTROUTING 2>/dev/null

	[ -x $IP6TABLES ] && {
		$IP6TABLES -t filter -D "zone_${ext_zone}_input" -j MINIUPNPD 2>/dev/null
		$IP6TABLES -t filter -D "zone_${ext_zone}_forward" -j MINIUPNPD 2>/dev/null
	}

	iptables_prepend_rule "$IPTABLES" filter "zone_${ext_zone}_input" MINIUPNPD
	iptables_prepend_rule "$IPTABLES" filter "zone_${ext_zone}_forward" MINIUPNPD
	iptables_prepend_rule "$IPTABLES" nat "zone_${ext_zone}_prerouting" MINIUPNPD
	iptables_prepend_rule "$IPTABLES" nat "zone_${ext_zone}_postrouting" MINIUPNPD-POSTROUTING

	[ -x $IP6TABLES ] && {
		iptables_prepend_rule "$IP6TABLES" filter "zone_${ext_zone}_input" MINIUPNPD
		iptables_prepend_rule "$IP6TABLES" filter "zone_${ext_zone}_forward" MINIUPNPD
	}
	ADDED=$(($ADDED + 1))
}

for ext_iface in $(uci -q get upnpd.config.external_iface); do
	add_extzone_rules $(fw3 -q network "$ext_iface")
done

add_extzone_rules $(uci -q get upnpd.config.external_zone)

if [ "$ADDED" -eq 0 ]; then
	network_find_wan wan_iface
	network_find_wan6 wan6_iface
	for ext_iface in $wan_iface $wan6_iface; do
		network_get_device ext_device $ext_iface
		[ -n "$ext_device" ] && add_extzone_rules $(fw3 -q device "$ext_device")
	done
fi

exit 0
